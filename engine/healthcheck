#!/bin/bash

# healthcheck: test if powerengine can update its status file after receiving a signal

PS4='+ healthcheck: '
exec >/proc/1/fd/1 2>/proc/1/fd/2 # send logs to docker log
set -x # DEBUG
set -e
set -o pipefail
(
	nodepid=`pgrep -f '^node'`
	touch /tmp/powerengine-healthcheck.cookie
	kill -USR2 $nodepid
	sleep 1
	test ! \( "/tmp/powerengine-health" -ot "/tmp/powerengine-healthcheck.cookie" \) -a x"$(< /tmp/powerengine-health)" = xOK
) || exit 1
